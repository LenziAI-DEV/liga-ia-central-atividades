# Modelo de configuração. Crie o seu .env.local com:  npm run setup
# (o setup copia este arquivo e gera APP_ENCRYPTION_KEY). NUNCA versione o .env.local.

# --- Google (obrigatório) — veja "Configuração do Google" no README ---
# Cliente OAuth do tipo "Aplicativo da Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID da pasta raiz de teste no Drive (trecho depois de /folders/ na URL)
DRIVE_TEST_FOLDER_ID=

# Chave AES-256 (32 bytes em base64) que cifra os tokens OAuth no banco local.
# Gerada automaticamente por `npm run setup`. Não troque depois de conectar.
APP_ENCRYPTION_KEY=

# --- IA (opcional) — sem chave, a análise de atas fica desativada ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opcionais (padrões entre parênteses) ---
# APP_BASE_URL=http://localhost:3000
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# SYNC_INTERVAL_SECONDS=60        (30 a 600)
# AI_DEBOUNCE_SECONDS=120        (0 a 600; espera a ata ficar estável antes de analisar)
# DATABASE_PATH=data/app.db
# INDEX_FILE_NAME=INDEX.md
# LOG_LEVEL=info                  (debug, info, warn, error)
