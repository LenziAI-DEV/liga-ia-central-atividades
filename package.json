{
  "name": "liga-ia-central-atividades",
  "version": "0.1.0",
  "private": true,
  "description": "Central de contexto e atividades da Liga IA UFSCar (case técnico)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "app": "next build && next start -H 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "data:clear": "node scripts/clear-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=src/server/** --coverage.include=src/lib/** --coverage.exclude=**/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "ai:record": "node scripts/ai-record.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@googleapis/drive": "^26.0.1",
    "fast-xml-parser": "^5.11.1",
    "google-auth-library": "^11.1.0",
    "jszip": "^3.10.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
